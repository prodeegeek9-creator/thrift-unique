# Committed on purpose.
#
# Both values are public by construction: Vite inlines them into the bundle,
# so anybody who loads the dashboard already has them. The publishable key is
# designed for this — RLS is what actually protects the data behind it, and
# this project's policies are the thing being relied on, not the key's secrecy.
#
# Committing them means a clone builds and a CI project deploys with no setup.
# Setting the same names as build environment variables on the Cloudflare
# project overrides what is here, which is how you would point a branch at a
# different Supabase project.
#
# The service-role key is NOT here and never will be — it goes on the Worker
# via `wrangler secret put`, where the browser cannot reach it.
VITE_SUPABASE_URL=https://vhmyzawgtstjtavwzpzn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_KUf47HUeHdYa2pIZaHIuug_F1yOvTqJ

# The platform bot's number, the one linked to WAHA as `ut-platform`. Public by
# nature: it's inside every "Open WhatsApp" link. Without it every
# listing/support button in the dashboard falls back or disappears.
VITE_WHATSAPP_NUMBER=2348154765611
