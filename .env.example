# The dashboard bundle. Vite inlines anything prefixed VITE_ at build time, so
# these are public by construction — the anon key is meant to be, and RLS is
# what actually protects the data behind it. Never put the service-role key
# here; it belongs on the Worker, set with `wrangler secret put`.
#
# A new, empty project — not the one the old single-store marketplace used.
# The schema in supabase/migrations builds it from nothing and does not migrate
# the old one; that data stays where it is.
#
# The URL is a public identifier and is committed. The key is not committed
# even though it is also public by design — keep .env.example a template, so
# nobody has to wonder which values in it are real.
#
# Use the publishable key (sb_publishable_...) rather than the legacy anon JWT:
# it rotates independently, which the legacy key cannot.
VITE_SUPABASE_URL=https://vhmyzawgtstjtavwzpzn.supabase.co
VITE_SUPABASE_ANON_KEY=

# The platform's own WhatsApp number, in wa.me form (digits only, no +).
# "Add product" is a deep link into the bot rather than a form — see
# src/lib/whatsapp.js — so without this the primary CTA on the listings screen
# has nowhere to go and the manual fallback is all that renders.
VITE_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is read by worker/ at request time and must NEVER carry a
# VITE_ prefix — that would inline it into a bundle any visitor can read.
# Set them with `wrangler secret put <NAME>`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase service role. The Worker uses it for the writes that must bypass
# RLS: escrow release, commission deduction, tenant provisioning. Every one of
# those paths names its tenant explicitly in every query, because the service
# key means Postgres has stopped checking it for us.
# SUPABASE_SERVICE_KEY=

# Signs the dashboard session cookie. Any long random string; rotating it logs
# everyone out, which is the intended emergency response.
# TOKEN_SECRET=

# Paystack. One key, two jobs: it takes payment and pays out, and it is also
# what webhook signatures are verified against -- Paystack signs the request
# body with your SECRET KEY and there is no separate webhook secret, whatever
# the dashboard's wording suggests.
# PAYSTACK_SECRET_KEY=

# WAHA, self-hosted (see infra/waha/). One session per tenant, routed by the
# platform rather than by the seller.
# WAHA_BASE_URL=
# WAHA_API_KEY=

# Meta, for publishing to a seller's own Page and Instagram Business account.
# One app, many tenants: each seller grants consent through the OAuth step at
# /connect, and their long-lived token is stored per tenant.
# META_APP_ID=
# META_APP_SECRET=

# TikTok Content Posting API. Business tier, and gated behind a one-time
# platform audit — until that clears, every post publishes private-only.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
