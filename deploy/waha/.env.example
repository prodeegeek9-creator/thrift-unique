# Copy this to .env next to docker-compose.yml on the VPS and fill it in.
# Never commit the real .env — deploy/waha/.gitignore keeps it out.

# The domain this WAHA instance answers on. Point an A record at the VPS's
# IP before starting the stack, so Caddy can get a certificate for it.
WAHA_DOMAIN=waha.yourdomain.com

# Sent as X-Api-Key on every call the Worker makes. Generate with:
#   openssl rand -hex 32
# This is the same value you'll set as WAHA_API_KEY on the Cloudflare Worker.
WAHA_API_KEY=

TZ=UTC
